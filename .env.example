# Copia este archivo a .env.local y llena los valores. NUNCA subas valores reales al repo.
# En producción se configuran en Vercel → Project → Settings → Environment Variables.

# Sitio
NEXT_PUBLIC_SITE_URL=https://edmoga.com

# WhatsApp de EDMOGA (formato internacional sin +, ej. 573185168451). Si se dejan vacíos, se usa el de ventas por defecto.
NEXT_PUBLIC_WHATSAPP_VENTAS=
NEXT_PUBLIC_WHATSAPP_MARKETING=

# Dropi (token de integración de la tienda: Dropi → Mis integraciones / Tienda)
# Si DROPI_TOKEN está vacío, los pedidos solo van a WhatsApp.
DROPI_TOKEN=
# Opcionales: dejar vacíos salvo que Dropi indique otra URL o encabezado.
# Por defecto: https://api.dropi.co/integrations y encabezado dropi-integration-key.
DROPI_API_URL=
DROPI_AUTH_HEADER=

# Registro anti-duplicados (Upstash Redis: Vercel → Storage → Upstash → conectar al proyecto;
# Vercel crea estas dos solas). Sin ellas, un pago o pedido repetido puede duplicarse en Dropi.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Supabase (Vercel → Storage → Supabase → conectar al proyecto; Vercel crea estas solas).
# Luego pegar supabase/esquema.sql en Supabase → SQL Editor → Run.
# Sin URL + SERVICE_ROLE_KEY, los pedidos no se guardan en la base de datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets (registro de ventas). Instalar docs/google-sheets.gs como app web de Apps Script.
# URL de la app web (termina en /exec) y la misma CLAVE que se puso en el script.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Bold — Botón de pagos (panel de Bold → Integraciones → Llaves). Sin estas dos, la tienda
# solo ofrece contra entrega. Usar primero las llaves de PRUEBA.
# Llave de identidad (pública):
BOLD_API_KEY=
# Llave secreta (firma de integridad y webhook):
BOLD_SECRET_KEY=
# Opcional: llave para verificar el webhook si es distinta de BOLD_SECRET_KEY.
# En modo pruebas Bold firma el webhook con llave vacía: definir BOLD_WEBHOOK_SECRET vacío.
# Webhook a configurar en Bold: https://edmoga.com/api/bold/webhook
BOLD_WEBHOOK_SECRET=

# Modo administrador (edmoga.com/admin) para cambiar precios. Clave que eliges tú, de 10 caracteres
# o más. Sin ella, /admin queda apagado. Necesita Supabase y la tabla `precios` (supabase/esquema.sql).
ADMIN_CLAVE=

# IA del chatbot Isis (DeepSeek o Gemini)
AI_PROVIDER=
AI_API_KEY=
